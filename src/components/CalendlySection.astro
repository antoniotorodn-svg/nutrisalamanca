---
import CalendlyEmbed from './CalendlyEmbed.astro';
---

<section class="section" id="reservar">
  <div class="container">
    <div class="calendly-header">
      <h2 class="section-title">Reserva tu cita</h2>
      <p class="section-sub">
        Selecciona el día y hora que mejor te convenga.
      </p>
    </div>

    <div class="calendly-type-toggle" id="calendlyType">
      <button class="calendly-type calendly-type--active" data-type="individual">Individual</button>
      <button class="calendly-type" data-type="parejas">Parejas</button>
    </div>

    <div class="calendly-panels">
      <div class="calendly-panel calendly-panel--active" id="panel-individual">
        <CalendlyEmbed type="individual" />
      </div>
      <div class="calendly-panel" id="panel-parejas">
        <CalendlyEmbed type="parejas" />
      </div>
    </div>

    <p class="text-center" style="margin-top: var(--spacing-lg); color: var(--text-light);">
      ¿Prefieres llamar? <a href="tel:+34623998939" style="color: var(--green-dark); font-weight: 600;">623 99 89 39</a> o escríbenos por <a href="https://wa.me/34623949796" target="_blank" rel="noopener" style="color: var(--green-dark); font-weight: 600;">WhatsApp</a>
    </p>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const typeButtons = document.querySelectorAll('.calendly-type');
    const panels = document.querySelectorAll('.calendly-panel');

    typeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type') || 'individual';
        typeButtons.forEach(b => b.classList.remove('calendly-type--active'));
        btn.classList.add('calendly-type--active');
        panels.forEach(p => p.classList.remove('calendly-panel--active'));
        const panel = document.getElementById(`panel-${type}`);
        if (panel) panel.classList.add('calendly-panel--active');
      });
    });
  });
</script>

<style>
  .calendly-header {
    margin-bottom: var(--spacing-lg);
  }

  .calendly-type-toggle {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 16px;
    background: var(--sand);
    border-radius: var(--radius-full);
    padding: 4px;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .calendly-type {
    padding: 8px 24px;
    border: none;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-light);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }

  .calendly-type--active {
    background: var(--white);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
  }

  .calendly-panel {
    display: none;
  }

  .calendly-panel--active {
    display: block;
  }
</style>
