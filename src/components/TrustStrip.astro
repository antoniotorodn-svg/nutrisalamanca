---
interface TrustItem {
  icon: string;
  text: string;
}

interface Props {
  items?: TrustItem[];
}

const {
  items = [
    { icon: "👋", text: "Adiós dietas milagro" },
    { icon: "🔋", text: "Recupera tu energía" },
    { icon: "💊", text: "Sin suplementos" },
    { icon: "📲", text: "Comunidad WhatsApp" },
    { icon: "🧑‍💻", text: "Área Pacientes" }
  ]
} = Astro.props;
---

<div class="trust-strip">
  <div class="container">
    <div class="trust-strip__grid">
      {items.map(item => (
        <div class="trust-strip__item">
          <span class="trust-strip__icon">{item.icon}</span>
          <span class="trust-strip__text">{item.text}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .trust-strip {
    padding: var(--spacing-md) 0;
    background-color: var(--gold-light);
    border-top: 1px solid var(--sand-dark);
    border-bottom: 1px solid var(--sand-dark);
  }

  .trust-strip__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    text-align: center;
  }

  .trust-strip__item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .trust-strip__icon {
    color: var(--green-dark);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .trust-strip__text {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    font-family: var(--font-body);
  }
</style>
