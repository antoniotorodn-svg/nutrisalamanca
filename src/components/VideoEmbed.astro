---
interface Props {
  title?: string;
  vertical?: boolean;
}

const {
  title = "Nutricionistas en Leganés — Soraya y José Luis",
  vertical = false
} = Astro.props;

const videoId = "1097937142";
const videoHash = "4b4a8240e6";
---

<div class={`hero-video ${vertical ? 'hero-video--vertical' : ''}`}>
  <iframe
    src={`https://player.vimeo.com/video/${videoId}?h=${videoHash}&title=0&byline=0&portrait=0`}
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
    title={title}
    loading="lazy"
  ></iframe>
</div>

<style>
  .hero-video {
    width: 280px;
    height: 500px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    background: linear-gradient(135deg, #F9E8D2, #F6DDAE);
    position: relative;
  }

  .hero-video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .hero-video {
      width: 200px;
      height: 356px;
      border-radius: 18px;
      margin: 0 auto;
    }
  }

  @media (max-width: 420px) {
    .hero-video {
      display: none;
    }
  }
</style>
