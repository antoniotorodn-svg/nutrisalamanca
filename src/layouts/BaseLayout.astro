---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: any;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = '/img/og-image.jpg',
  schema
} = Astro.props;

const siteUrl = 'https://nutricionistaenleganes.com';
const fullUrl = `${siteUrl}${canonical}`;
const fullOgImage = `${siteUrl}${ogImage}`;

// Schema por defecto: LocalBusiness
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": ["Dietitian", "LocalBusiness"],
  "name": "Nutricionista en Leganés — Soraya Sánchez & José Luis Todolí",
  "description": "Nutricionistas colegiados en Leganés. Consulta presencial en Clínica Podoimas y online. Pérdida de peso, nutrición deportiva, salud digestiva, hormonal y clínica.",
  "image": fullOgImage,
  "url": siteUrl,
  "telephone": "+34623998939",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Nuestra Señora de Begoña, 8",
    "addressLocality": "Leganés",
    "addressRegion": "Madrid",
    "postalCode": "28911",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "40.3280",
    "longitude": "-3.7635"
  },
  "priceRange": "40€ - 100€",
  "currenciesAccepted": "EUR",
  "paymentAccepted": "Cash, Credit Card, Bizum",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "21:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Leganés", "sameAs": "https://es.wikipedia.org/wiki/Leganés" },
    { "@type": "Place", "name": "Zarzaquemada" },
    { "@type": "Place", "name": "La Fortuna" },
    { "@type": "Place", "name": "San Nicasio" },
    { "@type": "Place", "name": "El Carrascal" },
    { "@type": "Place", "name": "Arroyo Culebro" },
    { "@type": "Place", "name": "Vereda de los Estudiantes" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de nutrición en Leganés",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Primera consulta de nutrición en Leganés", "description": "Valoración nutricional completa, análisis de composición corporal y plan personalizado" }, "price": "50", "priceCurrency": "EUR" },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Seguimiento nutricional" }, "price": "40", "priceCurrency": "EUR" },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pack 3 seguimientos" }, "price": "100", "priceCurrency": "EUR" }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "47",
    "bestRating": "5"
  },
  "sameAs": []
};

const schemas = schema ? [defaultSchema, schema] : [defaultSchema];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Principal -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={fullUrl}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="Nutricionista en Leganés — nutricionistaenleganes.com">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={fullUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={fullOgImage}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Preload LCP images -->
  <link rel="preload" as="image" href="/soraya-sanchez.webp" fetchpriority="high">
  <link rel="preload" as="image" href="/jose-luis-todoli.webp" fetchpriority="high">

  <!-- Google Fonts: DM Serif Display + DM Sans (non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&family=DM+Serif+Display&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&family=DM+Serif+Display&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  </noscript>

  <!-- Schema.org JSON-LD -->
  {schemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- DNS prefetch for lazy-loaded third parties -->
  <link rel="dns-prefetch" href="https://assets.calendly.com">
</head>
<body>
  <slot name="nav" />

  <main>
    <slot />
  </main>

  <slot name="footer" />

  <!-- Floating Buttons (desktop) -->
  <div class="floating-btns">
    <a href="https://wa.me/34644985209" class="float-btn float-wa" aria-label="WhatsApp" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
    <a href="#reservar" class="float-btn float-reserva" aria-label="Reservar cita">
      <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
    </a>
  </div>

  <!-- Mobile Bottom Nav (3 buttons) -->
  <div class="mobile-bottom-bar">
    <div class="bottom-nav-inner">
      <a href="tel:+34623998939" class="bottom-nav-btn bn-call">
        <svg viewBox="0 0 24 24"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
        Llamar
      </a>
      <a href="https://wa.me/34644985209" class="bottom-nav-btn bn-wa" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp
      </a>
      <a href="#reservar" class="bottom-nav-btn bn-reserva">
        <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
        Reservar
      </a>
    </div>
  </div>

  <!-- Cookie Consent Banner -->
  <CookieBanner />

  <!-- Scroll Reveal Animation (deferred to avoid blocking main thread) -->
  <script>
    function initReveal() {
      const revealElements = document.querySelectorAll('.section, .card, .hero, .cta-card, .value-item, .material-card, .testimonial-card, .resena-card, .benefit-item, .pricing-card, .trust-strip__item, .servicio-item');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -40px 0px'
      });

      revealElements.forEach((el) => {
        el.classList.add('reveal-on-scroll');
        observer.observe(el);
      });
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(initReveal);
    } else {
      setTimeout(initReveal, 200);
    }
  </script>
</body>
</html>
